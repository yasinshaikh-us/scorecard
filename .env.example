ANTHROPIC_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Plaid bank-linking integration (see api/_plaid.js, api/plaid-link-token.js,
# api/plaid-exchange.js). Get sandbox values from the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Service-role Supabase key, used only by api/plaid-exchange.js to write
# plaid_items/plaid_accounts/plaid_auth_numbers (tables regular users can't
# write to directly). Project Settings -> API -> service_role key.
# NEVER prefix this VITE_ — it must never ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Set these ONLY as Vercel Environment Variables and Supabase Edge Function
# secrets (Project Settings -> Edge Functions -> Secrets, or
# `supabase secrets set`) — never commit real values here. The Supabase
# Edge Functions (plaid-webhook, plaid-balance-refresh) need their own
# copies of PLAID_CLIENT_ID / PLAID_SECRET / PLAID_ENV; SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are auto-injected there, no action needed.
