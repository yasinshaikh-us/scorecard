# This project is mobile-only. The app's own build-time variables live in
# mobile/.env (see mobile/.env.example and mobile/README.md's Setup
# section) -- EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_ANON_KEY,
# which are safe to expose to the client by design, exactly as the two
# VITE_* variables that used to sit here were.
#
# Everything below is server-side only. The backend is entirely on
# Supabase, so these are set ONLY as Supabase Edge Function secrets
# (Project Settings -> Edge Functions -> Secrets, or `supabase secrets
# set`) -- never commit real values here. SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are auto-injected for every Edge Function, no
# action needed for those two.

# Held server-side by the `query` function -- see
# supabase/functions/query/index.ts.
ANTHROPIC_API_KEY=

# Plaid bank-linking integration (see supabase/functions/_shared/plaid.ts,
# plaid-link-token, plaid-exchange, plaid-disconnect, plaid-webhook,
# plaid-balance-refresh). Get sandbox values from the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
