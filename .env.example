# Frontend build vars (Vercel Environment Variables, or .env.local for
# `npm run dev`) — the only two the client bundle needs. Safe to expose to
# the browser by design (see src/supabaseClient.js).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Everything below is server-side only. The backend is entirely on
# Supabase now, so these are set ONLY as Supabase Edge Function secrets
# (Project Settings -> Edge Functions -> Secrets, or `supabase secrets
# set`) — never commit real values here, and never as Vercel env vars,
# since Vercel no longer runs any server-side code for this app.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected for every
# Edge Function, no action needed for those two.

# Held server-side by the `query` function — see
# supabase/functions/query/index.ts.
ANTHROPIC_API_KEY=

# Plaid bank-linking integration (see supabase/functions/_shared/plaid.ts,
# plaid-link-token, plaid-exchange, plaid-disconnect, plaid-webhook,
# plaid-balance-refresh). Get sandbox values from the Plaid dashboard.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
