{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.112.2",
    "aes-js": "^3.1.2",
    "expo": "~57.0.12",
    "expo-auth-session": "^57.0.6",
    "expo-build-properties": "~57.0.10",
    "expo-constants": "^57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "^57.0.5",
    "expo-router": "^57.0.12",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "^57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-plaid-link-sdk": "^13.0.4",
    "react-native-safe-area-context": "^5.8.1",
    "react-native-screens": "^4.27.0",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.7",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "detox": "^20.51.4",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "^19.2.8",
    "test-renderer": "^1.2.0",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "e2e:build:android": "detox build -c android.release",
    "e2e:test:android": "detox test -c android.release"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-gifted-charts|gifted-charts-core))"
    ],
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/e2e/"
    ]
  }
}
