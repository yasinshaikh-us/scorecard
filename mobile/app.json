{
  "expo": {
    "name": "fa/thm",
    "slug": "fathom",
    "scheme": "fathom",
    "owner": "yasin01s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#14181D"
          }
        }
      ],
      "./plugins/withDetoxTestBuildType.js",
      "./plugins/withDetoxAndroidModule.js",
      "./plugins/withDetoxTestStub.js",
      "./plugins/withDetoxReleaseCleartext.js",
      "./plugins/withReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fathom.app"
    },
    "android": {
      "package": "com.fathom.app",
      "adaptiveIcon": {
        "backgroundColor": "#14181D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a67bff36-641d-4253-b789-68292d6c18c4"
      }
    }
  }
}
